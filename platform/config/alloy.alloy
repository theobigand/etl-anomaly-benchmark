// OTLP in; logs to Loki, traces to Tempo, metrics to Prometheus (remote write). One collector, no second one.
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}

// Structured JSON log files of the pipeline containers (e2e_check.sh): event and level are labels,
// the correlation identifiers are structured metadata, so a run is found by its identifier.
local.file_match "etl" {
  path_targets = [{"__path__" = "/var/log/etl/*.log", "job" = "etl-pipeline"}]
}

loki.source.file "etl" {
  targets    = local.file_match.etl.targets
  forward_to = [loki.process.etl.receiver]
}

loki.process "etl" {
  stage.json {
    expressions = {
      event           = "event",
      level           = "level",
      pipeline_run_id = "pipeline_run_id",
      dag_run_id      = "dag_run_id",
      trace_id        = "trace_id",
    }
  }
  stage.labels {
    values = {
      event = "",
      level = "",
    }
  }
  stage.structured_metadata {
    values = {
      pipeline_run_id = "",
      dag_run_id      = "",
      trace_id        = "",
    }
  }
  forward_to = [loki.write.default.receiver]
}
