      "title": "Thesis 01 — Manuscript and methods corrections",
      "description": "Resolve scientific framing, detector definitions, dataset accounting, figures, and tables before new analysis."
    },
    {
      "title": "Thesis 02 — Statistical validity and deployment thresholds",
      "description": "Correct AP terminology, paired inference, source clustering, operational metrics, and label-free thresholding."
    },
    {
      "title": "Thesis 03 — Fair baselines and ETL fault fidelity",
      "description": "Evaluate domain-informed rules, categorical ML representations, robust statistics, and realistic typed injections."
    },
    {
      "title": "Thesis 04 — Hybrid pipelines and detector ablations",
      "description": "Validate rules-plus-model combinations, inductive adaptations, and equal-budget tuning."
    },
    {
      "title": "Thesis 05 — Temporal validity and operational cost",
      "description": "Validate chronological behavior, drift monitoring, training/inference costs, and scaling."
    },
    {
      "title": "Thesis 06 — IMRaD synthesis and academic quality",
      "description": "Rewrite Results, Discussion, and Conclusion and verify bibliography and scholarly presentation."
    },
    {
      "title": "Thesis 07 — Reproducibility and certified release",
      "description": "Preserve evidence lineage, close verification gaps, and produce a reproducible certified final release."
    },
    {
      "title": "Thesis 08 — Optional research extensions",
      "description": "Track non-blocking follow-up research beyond the minimum defensible thesis."
    }
