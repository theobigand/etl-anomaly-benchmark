.hypothesis/
.coverage
.coverage.*
coverage.json
mutants/
.mypy_cache/

# Build artefacts
build/
dist/
*.egg-info/

# Conda / virtualenv (should live outside the repo ideally, but just in case)
.venv/
venv/
env/
.conda/

# Datasets bruts (trop lourds pour git)
data/*.csv
!data/README.md

# Résultats d'expériences — générés, on ne versionne que le .gitkeep
experiments/results/*.csv
experiments/results/*.md
experiments/results/*.png
experiments/results/*.json
experiments/results/*.xml
experiments/results/*.log
experiments/results/*.gz
!experiments/results/.gitkeep

# LaTeX (le PDF compilé du papier est versionné, cf. paper/main.pdf)
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Notebooks checkpoints
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Generated verification snapshot; policy lives in profile.template.json
verification/profile.json
